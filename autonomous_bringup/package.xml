<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autonomous_bringup</name>
  <version>0.0.0</version>
  <description>Launch package for the autonomous vehicle system</description>
  <maintainer email="your_email@example.com">Your Name</maintainer>
  <license>Apache License 2.0</license> <!-- 혹은 원하는 라이선스 -->

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- 기본 의존성 -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- 실행할 노드가 포함된 패키지들을 여기에 추가 -->
  <exec_depend>cone_detection</exec_depend>
  <exec_depend>hungarian_association</exec_depend>
  <exec_depend>simple_slam</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>yolo_ros</exec_depend>
  <!-- custom_interface와 yolo_msgs는 메시지/서비스 패키지이지만,
       launch 파일에서 해당 타입의 파라미터를 사용하거나 할 경우 명시적으로 추가하면 좋습니다. -->
  <exec_depend>custom_interface</exec_depend>
  <exec_depend>yolo_msgs</exec_depend>
  <!-- 필요에 따라 더 많은 패키지 추가 -->


  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>